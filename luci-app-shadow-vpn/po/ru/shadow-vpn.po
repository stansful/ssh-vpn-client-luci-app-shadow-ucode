msgid "Routing import is larger than %s bytes."
msgstr "Файл импорта правил больше %s байт."

#: htdocs/luci-static/resources/shadow-vpn/common.js:174
msgid "Routing import contains more than %s rules."
msgstr "В файле импорта больше %s правил."

