msgid "Connecting to %s."
msgstr "Подключение к %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js:181
msgid "Reconnecting to %s (attempt %s)."
msgstr "Переподключение к %s (попытка %s)."

#: htdocs/luci-static/resources/shadow-vpn/common.js:182
msgid "Starting %s profile %s."
msgstr "Запуск профиля %s «%s»."

#: htdocs/luci-static/resources/shadow-vpn/common.js:183
msgid "Xray rejected the configuration: %s"
msgstr "Xray не принял конфигурацию: %s"

#: htdocs/luci-static/resources/shadow-vpn/common.js:184
msgid "SSH TCP connect timeout for %s."
msgstr "Не удалось подключиться к %s по TCP: истекло время ожидания."

#: htdocs/luci-static/resources/shadow-vpn/common.js:185
msgid "SSH keepalive timed out: nothing received from the server for %s s."
msgstr "Сервер не отвечает: от него ничего не приходило %s с."

#: htdocs/luci-static/resources/shadow-vpn/common.js:186
msgid "SSH server fingerprint mismatch: expected %s, got %s (%s)."
msgstr "Отпечаток сервера не совпал: ожидался %s, получен %s (%s)."

#: htdocs/luci-static/resources/shadow-vpn/common.js:187
msgid "SSH server host key does not match the key Shadow trusted on its first connection to %s: expected %s, got %s (%s). Shadow stopped so nothing is sent to a server that may be an impostor. If the server’s key was changed on purpose, paste the new fingerprint into the server’s Fingerprint field."
msgstr "Ключ сервера не совпадает с ключом, которому Shadow доверился при первом подключении к %s: ожидался %s, получен %s (%s). Shadow остановился, чтобы ничего не отправлять на возможно подменённый сервер. Если ключ сервера сменили намеренно, вставьте новый отпечаток в поле «Отпечаток сервера»."

#: htdocs/luci-static/resources/shadow-vpn/common.js:189
msgid "SSH authentication failed: Permission denied (%s)."
msgstr "Сервер отказал во входе (%s)."

#: htdocs/luci-static/resources/shadow-vpn/common.js:190
msgid "Local SOCKS port %s is already in use."
msgstr "Локальный SOCKS-порт %s уже занят."

#: htdocs/luci-static/resources/shadow-vpn/common.js:191
msgid "SSH exited: %s"
msgstr "SSH завершился: %s"

