'use strict';

// apply converge and teardown for real in the throwaway container (no procd: the instances are never
// declared, and ssh-up is played by calling ssh.session_up). Covers what only a converge decides: the phase
// an SSH-mode converge leaves when ssh keeps running, the NTP exemption, what a stop that is not an Off keeps,
// what Off clears, and a dnsmasq file of ours left in a confdir on flash.

import { access, readfile, writefile, unlink, mkdir, glob, rmdir, stat } from 'fs';
import { cursor } from 'uci';
import { write, remove } from 'shadow-vpn.secrets';
import { ok, eq, run, done, HERE, UCODE, LIBEXEC } from 'rt';

const APPLY = `${UCODE} ${LIBEXEC}/apply`;
const RUN = '/var/run/shadow-vpn', SID = 's_0000000000a1', UCI_FILE = '/etc/config/shadow-vpn';
const SYSTEM = '/etc/config/system', CONFDIR = '/tmp/rt-flash-confdir';
const RESOLV = '/tmp/resolv.conf.d/resolv.conf.auto';
const HEADER = '# Generated by shadow-vpn. Do not edit.';

if (access('/etc/shadow-vpn') || access(RUN) || access(UCI_FILE) || access(SYSTEM) || access(RESOLV) ||
    run('nft list table inet shadow_vpn').rc == 0) {
	print('ok converge # skipped: shadow-vpn state already present\n');
	done();
}

function state() {
	try {
		return json(readfile(`${RUN}/state.json`) ?? '{}');
	}
	catch (e) {
		return {};
	}
}

function attention_codes() {
	let a = [];

	try {
		a = json(readfile(`${RUN}/attention.json`) ?? '[]');
	}
	catch (e) { }

	return sort(map(a, (x) => x.code));
}

function converge(...flags) {
	return run(`${APPLY} converge --from-init ${join(' ', flags)}`);
}

function set_main(option, value) {
	let c = cursor();

	c.set('shadow-vpn', 'main', option, value);
	c.commit('shadow-vpn');
}

function session_up() {
	return run(`${UCODE} -e 'import { session_up } from "shadow-vpn.ssh"; session_up("${SID}");'`);
}

function dhcp_section() {
	let sec = null;

	cursor().foreach('dhcp', 'dnsmasq', (s) => { sec ??= s['.name']; });

	return sec;
}

mkdir('/var/run', 0o755);
mkdir('/var/lock', 0o755);
write(SID, 'password', 'fake-test-password');
writefile(UCI_FILE, readfile(`${HERE}/uci/render-ssh/shadow-vpn`));
// the WAN's DNS server: plain DNS outside the tunnel, which the exempt names use
mkdir('/tmp/resolv.conf.d', 0o755);
writefile(RESOLV, 'nameserver 192.0.2.53\n');
writefile(SYSTEM, "config system\n\toption hostname 'rt'\n\nconfig timeserver 'ntp'\n\toption enabled '1'\n" +
	"\tlist server '0.openwrt.pool.ntp.org'\n\tlist server '1.openwrt.pool.ntp.org'\n\tlist server '162.159.200.1'\n");

// ---- first converge: SSH, full mode ------------------------------------------------------------------

let r = converge();

ok('converge: arms SSH mode', r.rc == 0 && access(`${RUN}/active`) && state().phase == 'connecting', r.out);

let info = split(trim(readfile(`${RUN}/dnsmasq`) ?? ''), ' ');
let conf = readfile(`${info[1]}/shadow-vpn.conf`) ?? '';

ok('converge: the router\'s NTP names resolve through the WAN DNS, never the tunnel',
	index(conf, '\nserver=/0.openwrt.pool.ntp.org/1.openwrt.pool.ntp.org/192.0.2.53\n') >= 0 &&
	index(conf, '162.159.200.1') < 0 && match(conf, /nftset=[^\n]*ntp/) == null, conf);

// ---- ssh up, then a change that only touches xray.json ------------------------------------------------

session_up();
eq('converge: ssh-up reports the session', state().phase, 'connected');

let gen = readfile(`${RUN}/ssh.gen`), params = readfile(`${RUN}/ssh.${SID}.params`), xj = readfile(`${RUN}/xray.json`);

set_main('kill_switch', '0');
r = converge();
ok('converge ssh: a kill-switch change rewrites only xray.json',
	readfile(`${RUN}/xray.json`) != xj && readfile(`${RUN}/ssh.gen`) == gen && readfile(`${RUN}/ssh.${SID}.params`) == params, r.out);
eq('converge ssh: ...and the phase stays connected (ssh keeps its session)', [ state().phase, state().code ], [ 'connected', null ]);

// ---- xray parked by a config error while ssh runs ------------------------------------------------------

writefile(`${RUN}/xray.fatal`, '');
run(`${UCODE} -e 'import { attention_add } from "shadow-vpn.state"; attention_add("xray_config", "Xray rejected the configuration: test");'`);
converge();
eq('converge ssh: a parked xray shows its error', [ state().phase, state().code ], [ 'error', 'xray_config' ]);

session_up();
eq('converge ssh: ssh-up keeps xray\'s error while xray is parked', [ state().phase, state().code ], [ 'error', 'xray_config' ]);

// the fix changes xray.json, which clears the flag; ssh never restarted
set_main('kill_switch', '1');
converge();
eq('converge ssh: the fixed config shows the running session again', [ state().phase, state().code, attention_codes() ],
	[ 'connected', null, [] ]);

// ---- a changed server is a new connect -----------------------------------------------------------------

write(SID, 'password', 'another-test-password');
converge();
ok('converge ssh: a changed password restarts ssh (new ssh.gen) and shows Connecting',
	readfile(`${RUN}/ssh.gen`) != gen && state().phase == 'connecting', sprintf('%J', state()));

// ---- a stop that is not an Off keeps the fatal flag ------------------------------------------------------

writefile(`${RUN}/fatal`, sprintf('%J', { transport: 'ssh', sid: SID, code: 'auth', message: 'SSH authentication failed: password auth rejected' }));
run(`${UCODE} -e 'import { attention_add } from "shadow-vpn.state"; attention_add("ssh_fatal", "SSH authentication failed: password auth rejected");'`);
set_main('mode', 'selected-rules');

let c = cursor();

c.foreach('shadow-vpn', 'rule', (s) => { c.set('shadow-vpn', s['.name'], 'enabled', '0'); });
c.commit('shadow-vpn');
converge();
ok('converge: nothing to route tears down but keeps the fatal flag and the server stamp',
	!access(`${RUN}/active`) && access(`${RUN}/fatal`) && access(`${RUN}/ssh.stamp`) &&
	index(attention_codes(), 'nothing_to_route') >= 0, sprintf('%J', attention_codes()));

// ---- Off clears what the stopped run reported ------------------------------------------------------------

run(`${UCODE} -e 'import { attention_add } from "shadow-vpn.state"; attention_add("port_busy", "Port 5300 is already in use by AdGuardHome.");'`);
set_main('enabled', '0');
converge();
eq('converge: Off removes the fatal flags and their attentions', [ access(`${RUN}/fatal`) == true, attention_codes() ], [ false, [] ]);

// ---- a conf of ours in a confdir on flash, with nothing in RUN saying so (after a reboot) ------------------

let sec = dhcp_section();

if (sec) {
	c = cursor();
	c.set('dhcp', sec, 'confdir', CONFDIR);
	c.commit('dhcp');
	mkdir(CONFDIR, 0o755);
	writefile(`${CONFDIR}/shadow-vpn.conf`, `${HEADER}\nno-resolv\nserver=127.0.0.1#5300\n`);
	writefile(`${CONFDIR}/user.conf`, 'domain-needed\n');
	unlink(`${RUN}/dnsmasq`);
	set_main('enabled', '1');
	set_main('autostart', '0');

	r = converge('--boot');
	ok('converge --boot with autostart off removes our conf from a persistent confdir',
		!access(`${CONFDIR}/shadow-vpn.conf`) && access(`${CONFDIR}/user.conf`) && cursor().get('shadow-vpn', 'main', 'enabled') == '0',
		r.out);

	writefile(`${CONFDIR}/shadow-vpn.conf`, `${HEADER}\nno-resolv\n`);
	r = run(`${APPLY} teardown --from-init`);
	ok('teardown (also apk del and install.sh --uninstall) removes it too', !access(`${CONFDIR}/shadow-vpn.conf`), r.out);

	writefile(`${CONFDIR}/shadow-vpn.conf`, 'no-resolv\n');
	run(`${APPLY} teardown --from-init`);
	ok('teardown leaves a file of that name it did not write', access(`${CONFDIR}/shadow-vpn.conf`) == true);

	c = cursor();
	c.delete('dhcp', sec, 'confdir');
	c.commit('dhcp');
	run(`rm -rf ${CONFDIR}`);
}

// ---- clean up -------------------------------------------------------------------------------------------

run(`${APPLY} teardown --from-init`);
run('nft delete table inet shadow_vpn');

for (let fam in [ '-4', '-6' ]) {
	run(`ip ${fam} rule del fwmark 0x400000/0x400000 table 106 priority 106`);
	run(`ip ${fam} route flush table 106`);
}

remove(SID);
unlink(UCI_FILE);
unlink(SYSTEM);
unlink(RESOLV);
run(`rm -rf /etc/shadow-vpn ${RUN} /tmp/dnsmasq.*.d/shadow-vpn.conf`);
done();
