#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:366
#: htdocs/luci-static/resources/view/shadow-vpn/ssh.js:130
#: htdocs/luci-static/resources/view/shadow-vpn/ssh.js:326
msgid "Edit"
msgstr "Изменить"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:271
#: htdocs/luci-static/resources/view/shadow-vpn/routing.js:352
#: htdocs/luci-static/resources/view/shadow-vpn/xray.js:161
msgid "Add"
msgstr "Добавить"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:296
msgid "Switching to the selected server: connections through the tunnel will reopen."
msgstr "Переключаю на выбранный сервер: соединения через туннель переоткроются."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:297
msgid "Server selected. It will be used when you turn Shadow on."
msgstr "Сервер выбран. Он будет использован при включении."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:311
msgid "%d ms"
msgstr "%d мс"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:312
msgid "%s s"
msgstr "%s с"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:316
msgid "%s answered the TLS handshake in"
msgstr "%s ответил на TLS-рукопожатие за"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:318
msgid "%s answered with a TLS alert: the tunnel carries data, but the endpoint refused the probe handshake."
msgstr "%s ответил TLS-предупреждением: туннель передаёт данные, но сайт отклонил проверочное рукопожатие."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:320
msgid "%s answered: %s"
msgstr "%s ответил: %s"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:322
msgid "%s answered with data that is not TLS: the tunnel carries data, but something other than the endpoint may be answering."
msgstr "%s ответил не TLS-данными: туннель передаёт данные, но отвечать может не сам сайт."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:324
msgid "%s sent nothing: the tunnel opened the connection, but it could not be verified end to end."
msgstr "%s ничего не прислал: туннель открыл соединение, но проверить его до конца не удалось."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:326
msgid "The server could not open %s (%s)"
msgstr "Сервер не смог открыть %s (%s)"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:328
msgid "The tunnel opened a connection to %s but nothing came back within 12 s. Traffic is entering the tunnel and not reaching the server."
msgstr "Туннель открыл соединение с %s, но за 12 с ничего не вернулось. Трафик входит в туннель и не доходит до сервера."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:330
msgid "The check could not start through the local Xray: %s"
msgstr "Проверка не смогла начаться через локальный Xray: %s"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:332
msgid "The check failed."
msgstr "Проверка не прошла."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:344
msgid "Checking %s through the tunnel…"
msgstr "Проверяю %s через туннель…"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:347
msgid "The check is available when the tunnel is connected."
msgstr "Проверка доступна, когда туннель подключён."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:350
msgid "Not checked yet."
msgstr "Ещё не проверялся."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:356
msgid "Hysteria 2 runs over UDP (QUIC): the network may block UDP to the server or its ports, or the link’s password (auth), certificate pin (pinSHA256) or obfs password may be wrong."
msgstr "Hysteria 2 работает по UDP (QUIC): сеть может блокировать UDP до сервера или его портов, либо в ссылке неверны пароль (auth), отпечаток сертификата (pinSHA256) или пароль obfs."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:365
msgid "Address:"
msgstr "Адрес:"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:367
msgid "Check"
msgstr "Проверить"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:390
msgid "Check address"
msgstr "Адрес для проверки"

