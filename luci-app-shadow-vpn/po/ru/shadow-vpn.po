msgstr "Переподключение"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:169
msgid "The connection to the server was lost %s ago. Attempt %d."
msgstr "Связь с сервером пропала %s назад. Попытка %d."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:175
msgid "Server key changed"
msgstr "Ключ сервера изменился"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:176
msgid "Expected %s, the server showed %s (%s). This may be someone impersonating the server, so Shadow does not connect."
msgstr "Ожидался %s, сервер показал %s (%s). Это может быть подмена сервера, поэтому Shadow не подключается."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:179
msgid "Error"
msgstr "Ошибка"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:180
msgid "Retries stopped: fix the problem and connect again."
msgstr "Повторы остановлены: исправьте ошибку и подключитесь снова."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:183
msgctxt "state"
msgid "Not connected"
msgstr "Не подключено"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:184
msgid "Shadow is on but not running. See the messages above."
msgstr "Shadow включён, но не работает. Причина — в сообщениях выше."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:194
msgid "Turn on"
msgstr "Включить"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:199
msgid "Connect again"
msgstr "Подключить снова"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:201
msgid "Turn off"
msgstr "Выключить"

