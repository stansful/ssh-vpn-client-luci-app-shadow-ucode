#: htdocs/luci-static/resources/view/shadow-vpn/xray.js:206
msgid "Transport"
msgstr "Транспорт"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:268
msgid "SSH server"
msgstr "SSH-сервер"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:268
msgid "Xray profile"
msgstr "Xray-профиль"

