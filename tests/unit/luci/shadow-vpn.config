config shadow 'main'
	option enabled '0'
	option autostart '1'
	option transport 'ssh'
	option mode 'proxy-all'
	option kill_switch '1'
	option check_endpoint 'youtube.com:443'
	option check_after_connect '1'
	option ssh_udp 'reject'
	option tunnel_dns '1'
	option ipv6 '0'
	option dns_redirect '1'
	option router_traffic '1'
	option lists_refresh '24'
	option log_level 'warning'

config list 'proxy'
	option enabled '0'

config list 'direct'
	option enabled '0'
