#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The size of %s does not match the release."
msgstr "Размер %s не совпадает с указанным в выпуске."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "GitHub lists another checksum for %s than SHA256SUMS."
msgstr "GitHub указывает для %s другую контрольную сумму, чем SHA256SUMS."

#: htdocs/luci-static/resources/shadow-vpn/common.js
#: htdocs/luci-static/resources/view/shadow-vpn/settings.js
msgid "Shadow %s must be installed with the install command from the console."
msgstr "Shadow %s нужно установить командой установки из консоли."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The package manager could not install the update: %s"
msgstr "Менеджер пакетов не смог установить обновление: %s"

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The package manager did not install Shadow %s."
msgstr "Менеджер пакетов не установил Shadow %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "Shadow %s was installed, but the tunnel did not come back within %s s."
msgstr "Shadow %s установлен, но туннель не восстановился за %s с."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "Shadow %s was installed, but the tunnel did not come back, so Shadow %s was put back."
msgstr "Shadow %s установлен, но туннель не восстановился, поэтому возвращён Shadow %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "Shadow %s was installed, but the tunnel did not come back, and putting Shadow %s back failed: %s"
msgstr "Shadow %s установлен, но туннель не восстановился, а вернуть Shadow %s не удалось: %s"

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The packages of the installed Shadow %s could not be downloaded for a rollback, so it was not updated automatically."
msgstr "Не удалось скачать для отката пакеты установленного Shadow %s, поэтому автоматического обновления не было."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "Shadow %s is available."
msgstr "Доступен Shadow %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The automatic update to %s failed: %s"
msgstr "Не удалось автоматически обновить Shadow до %s: %s"

#: htdocs/luci-static/resources/shadow-vpn/common.js
msgid "The automatic update to %s was interrupted."
msgstr "Автоматическое обновление до %s было прервано."

#. Backend message (rpcd plugin, update.uc, update)
msgid "No Shadow release is published yet."
msgstr "Ни одного выпуска Shadow пока не опубликовано."

#. Backend message (rpcd plugin, update.uc, update)
msgid "GitHub refused the request: too many requests from this address. Try again in an hour."
msgstr "GitHub отклонил запрос: с этого адреса было слишком много запросов. Повторите через час."

#. Backend message (rpcd plugin, update.uc, update)
msgid "Could not reach GitHub to check for updates."
msgstr "Не удалось связаться с GitHub, чтобы проверить обновления."

#. Backend message (rpcd plugin, update.uc, update)
msgid "GitHub returned a release that Shadow cannot read."
msgstr "GitHub вернул выпуск, который Shadow не может прочитать."

#. Backend message (rpcd plugin, update.uc, update)
msgid "Shadow is already checking for or installing an update. Try again in a minute."
msgstr "Shadow уже проверяет или устанавливает обновление. Повторите через минуту."

#. Backend message (rpcd plugin, update.uc, update)
msgid "An update is already running."
msgstr "Обновление уже выполняется."

#. Backend message (rpcd plugin, update.uc, update)
msgid "Could not take the update lock."
msgstr "Не удалось получить блокировку обновления."

#. Backend message (rpcd plugin, update.uc, update)
msgid "The router clock is wrong, so HTTPS does not work. Check time synchronization in System → System."
msgstr "Часы роутера показывают неверное время, поэтому HTTPS не работает. Проверьте синхронизацию времени в разделе «Система → Система»."

#. Backend message (rpcd plugin, update.uc, update)
msgid "The installed Shadow version is unknown."
msgstr "Установленная версия Shadow неизвестна."

#. Backend message (rpcd plugin, update.uc, update)
msgid "Shadow blocks the router’s own downloads while its tunnel is down (kill switch). Turn Shadow off, update, then turn it back on."
msgstr "Пока туннель не работает, Shadow блокирует загрузки самого роутера (kill switch). Выключите Shadow, обновите его и включите снова."

#. Backend message (rpcd plugin, update.uc, update)
msgid "SHA256SUMS is malformed."
msgstr "Файл SHA256SUMS имеет неверный формат."
