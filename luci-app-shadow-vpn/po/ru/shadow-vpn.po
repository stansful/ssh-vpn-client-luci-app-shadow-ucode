msgstr "В ссылке %s должны быть адрес сервера и правильный порт."

#: htdocs/luci-static/resources/shadow-vpn/common.js:165
msgid "Import text is longer than %s characters."
msgstr "Текст для импорта длиннее %s символов."

#: htdocs/luci-static/resources/shadow-vpn/common.js:166
msgid "Import contains %s lines; maximum is %s. Extra lines were ignored."
msgstr "В импорте %s строк, а можно не больше %s. Лишние строки пропущены."

#: htdocs/luci-static/resources/shadow-vpn/common.js:167
msgid "proxy link is longer than %s bytes."
msgstr "ссылка длиннее %s байт."

#: htdocs/luci-static/resources/shadow-vpn/common.js:168
