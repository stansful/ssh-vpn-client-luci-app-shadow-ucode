#!/bin/sh
# procd instance "xray": decides, then execs xray, so no supervisor stays resident (DESIGN.md 6.7).
# - a fatal config error (found by -test after a crash loop) parks the instance until the next Connect
# - 3 exits within 30 s of their start run "xray run -test" once, then back off 5 -> 60 s
# - a detached watcher runs gate-set once xray listens, and after 10 s in fallback mode if it does not
# xray-run --watch is that watcher.

RUN=/var/run/shadow-vpn
LIBEXEC=/usr/libexec/shadow-vpn
XRAY=/usr/bin/xray
CONF="$RUN/xray.json"
FALLBACK_SEC=10
QUICK_SEC=30
QUICK_MAX=3
WATCH_MAX=120

uptime_s() {
	local up
	read -r up _ < /proc/uptime
	echo "${up%.*}"
}

# Settings → Logs as the last converge validated it (DESIGN.md 6.8); none yet counts as warning
LOG_LEVEL=
[ -s "$RUN/log_level" ] && read -r LOG_LEVEL < "$RUN/log_level"

# log <err|warn|info|debug> <text>: Shadow's lines at that level, as state.log() does
log() {
	local prio="$1"
	shift
	case "$LOG_LEVEL" in
		debug) ;;
		info) [ "$prio" = debug ] && return 0 ;;
		error) [ "$prio" = err ] || return 0 ;;
		*) [ "$prio" = err ] || [ "$prio" = warn ] || return 0 ;;
	esac
	logger -t shadow-vpn -p "daemon.$prio" "$*"
}

listening() {
	grep -qE '^ *[0-9]+: (0100007F|7F000001):3039 [0-9A-F]{8}:0000 0A ' /proc/net/tcp
}

xray_transport() {
	[ "$(cat "$RUN/transport" 2>/dev/null)" = xray ]
}

# The Xray transport has no handshake of its own to report: listening is "connected".
set_state() {
	xray_transport && "$LIBEXEC/apply" state "$@" >/dev/null 2>&1
}

# The outage counts from RUN/xray.down (the first respawn), not from this watcher's start: in a crash
# loop every start replaces the watcher, so a count of its own would never reach FALLBACK_SEC.
down_for() {
	local since

	read -r since < "$RUN/xray.down" 2>/dev/null || { echo 0; return; }
	echo $(($(uptime_s) - ${since:-0}))
}

watch() {
	local i=0 opened=0

	while [ $i -lt $WATCH_MAX ]; do
		if listening; then
			log debug "xray: listening ${i} s after its start"
			rm -f "$RUN/xray.down"
			"$LIBEXEC/gate-set"
			set_state connected ""
			exit 0
		fi
		if [ $opened = 0 ] && [ "$(down_for)" -ge $FALLBACK_SEC ]; then
			log debug "xray: down for ${FALLBACK_SEC} s or more; asking gate-set"
			"$LIBEXEC/gate-set"
			opened=1
		fi
		sleep 1
		i=$((i + 1))
	done
	log warn "xray: not listening ${WATCH_MAX} s after its start"
	"$LIBEXEC/gate-set"
	exit 0
}

stop_watcher() {
	local pid

	pid="$(cat "$RUN/xray-watch.pid" 2>/dev/null)"
	# a stale pid may belong to someone else by now
	[ -n "$pid" ] && grep -q xray-run "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null
	rm -f "$RUN/xray-watch.pid"
}

start_watcher() {
	stop_watcher
	start-stop-daemon -S -b -m -p "$RUN/xray-watch.pid" -x /bin/sh -- "$0" --watch
}

# A parked instance needs no watcher: the gate is set here and stays until the next Connect.
park() {
	stop_watcher
	"$LIBEXEC/gate-set"
	exec sleep 2147483647
}

[ "$1" = --watch ] && watch

mkdir -p -m 0700 "$RUN"
[ -s "$CONF" ] || exec sleep 2147483647

# The gate counts the outage from here: procd starts us after xray exited.
[ -s "$RUN/xray.down" ] || uptime_s > "$RUN/xray.down"

if [ -e "$RUN/xray.fatal" ]; then
	park
fi

now="$(uptime_s)"
quick=0 last=0 tested=0
[ -s "$RUN/xray.quick" ] && read -r quick last tested < "$RUN/xray.quick"
if [ "${last:-0}" -gt 0 ] && [ $((now - last)) -lt $QUICK_SEC ]; then
	quick=$((quick + 1))
else
	quick=0
	tested=0
fi

if [ "$quick" -ge "$QUICK_MAX" ]; then
	if [ "$tested" != 1 ]; then
		tested=1
		"$XRAY" run -test -c "$CONF" > "$RUN/xray.test" 2>&1
		if [ $? -eq 23 ]; then
			touch "$RUN/xray.fatal"
			"$LIBEXEC/apply" xray-fatal "$RUN/xray.test" >/dev/null 2>&1
			rm -f "$RUN/xray.test"
			log err "xray: configuration error, not restarting until the next Connect"
			park
		fi
		rm -f "$RUN/xray.test"
	fi

	delay=5
	n=$QUICK_MAX
	while [ $n -lt "$quick" ] && [ $delay -lt 60 ]; do
		delay=$((delay * 2))
		n=$((n + 1))
	done
	[ $delay -gt 60 ] && delay=60
	log warn "xray: exited $quick times in a row, next start in ${delay}s"
	start_watcher
	sleep "$delay"
fi

# A previous start in this cycle means xray died (a converge that changes xray.json, a Connect and a teardown
# remove xray.quick): show it as reconnecting. A single exit is otherwise silent, procd and xray log nothing.
if [ "${last:-0}" -gt 0 ]; then
	[ "$quick" -lt "$QUICK_MAX" ] && log warn "xray: exited, the previous start was $((now - last)) s ago; starting again"
	set_state reconnecting "Xray runtime exited; restarting."
fi
echo "$quick $(uptime_s) $tested" > "$RUN/xray.quick"

log debug "xray: starting (generation ${SHADOW_GEN:-none}, quick exits $quick)"
start_watcher
exec "$XRAY" run -c "$CONF"
