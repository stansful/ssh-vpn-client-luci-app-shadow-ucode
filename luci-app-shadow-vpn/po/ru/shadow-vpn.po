msgstr "Ссылка длиннее %s символов."

#: htdocs/luci-static/resources/shadow-vpn/common.js:169
msgid "Proxy profile count exceeds the %s profile limit."
msgstr "Превышен лимит профилей: не больше %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js:170
msgid "CIDR prefix must be between 0 and %s."
msgstr "Длина префикса CIDR должна быть от 0 до %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js:171
msgid "Keepalive must be a whole number of seconds from %s to %s."
msgstr "Интервал проверки связи — целое число секунд от %s до %s."

#: htdocs/luci-static/resources/shadow-vpn/common.js:172
msgid "Routing rule count exceeds the %s rule limit."
msgstr "Превышен лимит правил маршрутизации: не больше %s."

