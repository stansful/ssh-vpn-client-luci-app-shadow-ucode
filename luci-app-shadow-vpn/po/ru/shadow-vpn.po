msgid "Overview"
msgstr "Обзор"

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid arguments."
msgstr "Неверные параметры запроса."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to start the background job."
msgstr "Не удалось запустить фоновую задачу."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Internal error. See the system log."
msgstr "Внутренняя ошибка. Подробности — в системном журнале."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Select a private key."
msgstr "Выберите закрытый ключ."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Password is too long."
msgstr "Пароль слишком длинный."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to store the password."
msgstr "Не удалось сохранить пароль."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No server key has been seen yet. Connect once, then pin the key."
msgstr "Ключ сервера ещё не встречался. Подключитесь один раз, затем закрепите ключ."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to update the known hosts file."
msgstr "Не удалось обновить список известных серверов."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH private key is too large."
msgstr "Закрытый ключ слишком большой."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Passphrase is too long."
msgstr "Пароль ключа слишком длинный."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "DSA keys can’t sign in. Use an Ed25519, ECDSA or RSA key."
msgstr "С DSA-ключом войти нельзя. Используйте ключ Ed25519, ECDSA или RSA."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to store the private key."
msgstr "Не удалось сохранить закрытый ключ."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to store the passphrase."
msgstr "Не удалось сохранить пароль ключа."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to store the link."
msgstr "Не удалось сохранить ссылку."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Rule value is too long."
msgstr "Значение правила слишком длинное."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Routing rule does not exist."
msgstr "Правило не найдено."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "The file is not valid JSON, so nothing was imported."
msgstr "Файл — не JSON, поэтому ничего не импортировано."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Tunnel check is available while the tunnel is connected."
msgstr "Проверка доступна, когда туннель подключён."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Job not found."
msgstr "Задача не найдена."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid value."
msgstr "Неверное значение."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unknown setting."
msgstr "Неизвестная настройка."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "This profile uses an unsupported security mode or transport, so it can't be selected."
msgstr "Профиль использует неподдерживаемый режим защиты или транспорт, поэтому его нельзя выбрать."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Select or create an SSH configuration before connecting."
msgstr "Перед подключением выберите или добавьте SSH-сервер."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Select or import an Xray profile before connecting."
msgstr "Перед подключением выберите или импортируйте Xray-профиль."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Selected rules mode requires at least one enabled routing rule or enabled proxy-list domain."
msgstr "В режиме «Только выбранное» нужно хотя бы одно включённое правило или включённый список доменов."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH configuration does not exist."
msgstr "SSH-сервер не найден."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Proxy profile does not exist."
msgstr "Профиль не найден."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH key does not exist."
msgstr "Ключ не найден."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "This private key is used by at least one SSH configuration."
msgstr "Этот ключ используется хотя бы одним SSH-сервером."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Secret record is missing."
msgstr "Сохранённый секрет не найден."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Profile name is empty."
msgstr "Имя профиля пустое."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Import file must contain a rules array."
msgstr "В файле импорта должен быть список правил."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "This rule already exists."
msgstr "Такое правило уже есть."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Domain pattern is required."
msgstr "Укажите домен."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Domain pattern is too long."
msgstr "Домен слишком длинный."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Domain pattern must include at least two labels."
msgstr "Домен должен состоять хотя бы из двух частей, например example.com."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Domain labels may contain letters, numbers, and internal hyphens."
msgstr "Части домена могут содержать буквы, цифры и дефисы внутри."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "IP address or CIDR is required."
msgstr "Укажите IP-адрес или подсеть."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "CIDR may contain only one slash."
msgstr "В подсети может быть только одна косая черта."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "IP address must be valid IPv4 or IPv6."
msgstr "IP-адрес должен быть правильным адресом IPv4 или IPv6."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "CIDR prefix must be a number."
msgstr "Длина префикса подсети должна быть числом."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "CIDR prefix must not have leading zeros."
msgstr "Длина префикса подсети не должна начинаться с нуля."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "CIDR prefix must be between 0 and 32."
msgstr "Длина префикса подсети должна быть от 0 до 32."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "CIDR prefix must be between 0 and 128."
msgstr "Длина префикса подсети должна быть от 0 до 128."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Endpoint is required. Use host:port."
msgstr "Укажите адрес в виде сайт:порт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Enter host:port without https:// or a path — for example youtube.com:443."
msgstr "Введите сайт:порт без https:// и пути — например, youtube.com:443."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Endpoint must use host:port, for example youtube.com:443."
msgstr "Адрес должен быть в виде сайт:порт, например youtube.com:443."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Endpoint must use host:port with a valid TCP port."
msgstr "Адрес должен быть в виде сайт:порт с правильным TCP-портом."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Name is required."
msgstr "Укажите имя."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Name is too long."
msgstr "Имя слишком длинное."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Host is required."
msgstr "Укажите адрес сервера."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Host is too long."
msgstr "Адрес сервера слишком длинный."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Username is required."
msgstr "Укажите пользователя."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Username is too long."
msgstr "Имя пользователя слишком длинное."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Note is too long."
msgstr "Заметка слишком длинная."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Enter only the server address in Host."
msgstr "В поле «Адрес» введите только адрес сервера."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Enter only the user name in Username."
msgstr "В поле «Пользователь» введите только имя пользователя."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Enter a port from 1 to 65535."
msgstr "Введите порт от 1 до 65535."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Keepalive must be a whole number of seconds from 5 to 3600."
msgstr "Проверка связи — целое число секунд от 5 до 3600."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Keepalive must be a whole number of seconds from 60 to 3600."
msgstr "Проверка связи — целое число секунд от 60 до 3600."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH private key is empty."
msgstr "Закрытый ключ пустой."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH private key field contains a public key. Paste the private key contents instead."
msgstr "Вставлен открытый ключ. Вставьте содержимое закрытого ключа."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH private key must start with a PRIVATE KEY PEM/OpenSSH header. Paste the key contents, not a file path."
msgstr "Закрытый ключ должен начинаться с заголовка PRIVATE KEY (PEM/OpenSSH). Вставьте содержимое ключа, а не путь к файлу."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Private key is required for a new key."
msgstr "Для нового ключа нужен сам закрытый ключ."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unable to load SSH private key because it is a security-key (FIDO) key, which signs only with its hardware key. Use an Ed25519, ECDSA or RSA key."
msgstr "Этот ключ — аппаратный (FIDO): он подписывает только с помощью устройства. Используйте ключ Ed25519, ECDSA или RSA."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Only vless://, vmess://, trojan://, and hysteria2:// links are supported."
msgstr "Поддерживаются только ссылки vless://, vmess://, trojan:// и hysteria2://."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid VLESS URI."
msgstr "Неверная ссылка VLESS."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid TROJAN URI."
msgstr "Неверная ссылка Trojan."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "VLESS URI must contain host and valid port."
msgstr "В ссылке VLESS должны быть адрес сервера и правильный порт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "TROJAN URI must contain host and valid port."
msgstr "В ссылке Trojan должны быть адрес сервера и правильный порт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid VMess base64 JSON payload."
msgstr "Неверная ссылка VMess: данные не читаются как base64 JSON."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "VMess payload must contain add and valid port."
msgstr "В ссылке VMess должны быть адрес (add) и правильный порт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid Hysteria 2 link."
msgstr "Неверная ссылка Hysteria 2."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Hysteria 2 link must contain a server host."
msgstr "В ссылке Hysteria 2 нет адреса сервера."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Hysteria 2 link has an invalid port list."
msgstr "В ссылке Hysteria 2 неверный порт или список портов."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Hysteria 2 salamander obfuscation needs obfs-password."
msgstr "Для обфускации salamander в Hysteria 2 нужен obfs-password."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid Hysteria 2 ech: expected a base64 ECHConfigList."
msgstr "Неверный параметр ech в Hysteria 2: нужен ECHConfigList в base64."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid Hysteria 2 pinSHA256: expected a SHA-256 certificate hash."
msgstr "Неверный pinSHA256 в Hysteria 2: нужен SHA-256 хэш сертификата."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid Hysteria 2 fm parameter: expected finalmask JSON."
msgstr "Неверный параметр fm в Hysteria 2: нужен JSON finalmask."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid fm parameter: expected finalmask JSON."
msgstr "Неверный параметр fm: нужен JSON finalmask."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "The hysteria transport needs security=tls."
msgstr "Для транспорта hysteria нужен security=tls."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unsupported proxy URI protocol."
msgstr "Неподдерживаемый протокол ссылки."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unsupported proxy security mode."
msgstr "Неподдерживаемый режим защиты."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Unsupported proxy transport: unknown."
msgstr "Неподдерживаемый транспорт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Xray no longer runs the HTTP/2 transport (type=h2 or http). Ask your provider for an XHTTP link."
msgstr "Xray больше не поддерживает транспорт HTTP/2 (type=h2 или http). Попросите у провайдера ссылку с XHTTP."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid URL"
msgstr "Неверная ссылка"

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No valid Xray links were imported."
msgstr "Не импортировано ни одной правильной ссылки Xray."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Routing proxy list refresh returned no domains."
msgstr "После обновления в списке не оказалось доменов."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: password auth rejected"
msgstr "Сервер отклонил пароль."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: private-key auth rejected"
msgstr "Сервер отклонил ключ."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: no auth method available."
msgstr "Нет подходящего способа входа на сервер."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH password is unavailable."
msgstr "Пароль для сервера не сохранён."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH private key is unavailable."
msgstr "Ключ для сервера не сохранён."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: Unable to load SSH private key because it is protected with a passphrase, and none was provided."
msgstr "Ключ защищён паролем, а пароль ключа не сохранён."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: Unable to load SSH private key because the passphrase is wrong."
msgstr "Неверный пароль ключа."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: Unable to load SSH private key. Check the key format and passphrase."
msgstr "Не удалось прочитать ключ. Проверьте формат ключа и пароль."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH host key signature verification failed."
msgstr "Подпись ключа сервера не прошла проверку."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH transport closed."
msgstr "Соединение с сервером закрыто."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH server disconnected."
msgstr "Сервер разорвал соединение."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Timed out waiting for SSH identification."
msgstr "Сервер не прислал SSH-приветствие: возможно, это не тот порт или соединение режется."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Socket closed before SSH identification."
msgstr "Соединение закрылось до SSH-приветствия: возможно, это не тот порт или соединение блокируется."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Reconnect stopped. Update the SSH configuration or key, then connect again."
msgstr "Переподключение остановлено. Исправьте сервер или ключ и подключитесь снова."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Reconnect stopped because SSH host trust or credentials require user action."
msgstr "Переподключение остановлено: нужно проверить ключ сервера или данные для входа."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Tunnel check endpoint must be host:port."
msgstr "Адрес проверки должен быть в виде сайт:порт."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH host key could not be checked because the host-key helper failed."
msgstr "Не удалось проверить ключ сервера: сбой программы проверки."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH host key verification failed."
msgstr "Ключ сервера не прошёл проверку."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: Unable to load SSH private key because its file is readable by other users."
msgstr "Не удалось загрузить ключ: файл ключа доступен другим пользователям."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH authentication failed: private-key auth rejected, or the key passphrase is wrong."
msgstr "Сервер отклонил ключ, или неверен пароль ключа."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No compatible SSH server host key algorithm."
msgstr "Нет общего алгоритма ключа сервера."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No compatible SSH kex algorithm."
msgstr "Нет общего алгоритма обмена ключами."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No compatible SSH client-to-server encryption algorithm."
msgstr "Нет общего алгоритма шифрования."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No compatible SSH client-to-server mac algorithm."
msgstr "Нет общего алгоритма MAC."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "No compatible SSH client-to-server compression algorithm."
msgstr "Нет общего алгоритма сжатия."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Timed out waiting for SSH packet."
msgstr "Сервер перестал отвечать во время установки соединения."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH exited without an error message."
msgstr "SSH завершился без сообщения об ошибке."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "SSH stopped after an error."
msgstr "SSH остановлен после ошибки."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Nothing to route: turn on a domain list, add a rule, or switch to Proxy all."
msgstr "Нечего направлять в туннель: включите список доменов, добавьте правило или выберите режим «Весь трафик»."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "The selected Xray profile has no usable outbound."
msgstr "Из выбранного Xray-профиля не удалось собрать подключение."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Enter a MAC address (aa:bb:cc:dd:ee:ff), an IP address or a CIDR."
msgstr "Введите MAC-адрес (aa:bb:cc:dd:ee:ff), IP-адрес или подсеть."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "MAC address, IP address or CIDR is required."
msgstr "Укажите MAC-адрес, IP-адрес или подсеть."

#. Backend message (rpcd plugin, validate.uc, links.uc, keys.uc, ssh, runtime)
msgid "Invalid list."
