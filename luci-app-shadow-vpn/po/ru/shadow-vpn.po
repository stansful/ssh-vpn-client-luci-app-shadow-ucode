msgstr "Сводка"

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:125
msgid "The server has not answered for %s."
msgstr "Сервер не отвечает %s."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:125
msgid "The server does not answer."
msgstr "Сервер не отвечает."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:126
msgid "Tunnelled sites are blocked until the tunnel is back."
msgstr "Сайты из туннеля заблокированы, пока туннель не вернётся."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:126
msgid "Tunnelled sites go directly until the tunnel is back."
msgstr "Сайты из туннеля идут напрямую, пока туннель не вернётся."

#: htdocs/luci-static/resources/view/shadow-vpn/overview.js:130
